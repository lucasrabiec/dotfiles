#!/usr/bin/env bash

set -euo pipefail

DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/timewarrior/data"
HOST="$(hostname)"
NOW="$(date '+%Y-%m-%d %H:%M')"

cd "$DATA_DIR"

git add .

if git diff --cached --quiet; then
    echo "✓ Nothing to push."
    exit 0
fi

git commit -m "sync: worklog from ${HOST} (${NOW})"

echo "→ Pushing changes..."
git push origin main

echo "✓ Timewarrior data pushed successfully."
