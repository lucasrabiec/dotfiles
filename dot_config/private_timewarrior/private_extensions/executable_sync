#!/usr/bin/env bash

set -euo pipefail

data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/timewarrior/data"
host="$(hostname)"
now="$(date '+%Y-%m-%d %H:%M')"

cd "$data_dir"

echo "→ checking local changes..."

git add .

if ! git diff --cached --quiet; then
  git commit -m "sync: worklog from ${host} (${now})"
else
  echo "  no local changes."
fi

echo "→ fetching remote changes..."

if ! git fetch origin; then
  echo
  echo "✗ failed to fetch remote changes."
  echo "  local commits are safe and will be pushed on the next sync."
  exit 1
fi

echo "→ rebasing onto origin/main..."

if ! git rebase origin/main; then
  echo
  echo "✗ sync conflict detected."
  echo "  no remote data was overwritten."
  echo "  rebase has been aborted."
  echo
  echo "  run:"
  echo
  echo "    timew resolve"
  echo

  git rebase --abort
  exit 1
fi

ahead="$(git rev-list --count origin/main..HEAD)"

if [ "$ahead" -gt 0 ]; then
  echo "→ pushing ${ahead} local commit(s)..."
  git push origin main
else
  echo "→ no local commits to push."
fi

echo
echo "✓ timewarrior synchronized successfully."
