#!/usr/bin/env bash

set -euo pipefail

DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/timewarrior/data"
HOST="$(hostname)"
NOW="$(date '+%Y-%m-%d %H:%M')"

cd "$DATA_DIR"

HAS_LOCAL_CHANGES=false

echo "→ Checking local changes..."

git add .

if ! git diff --cached --quiet; then
  git commit -m "chore(timew): sync worklog from ${HOST} (${NOW})"
  HAS_LOCAL_CHANGES=true
else
  echo "  No local changes."
fi

echo "→ Fetching remote changes..."
git fetch origin

echo "→ Rebasing onto origin/main..."

if ! git rebase origin/main; then
  echo
  echo "✗ Sync conflict detected."
  echo "  No remote data was overwritten."
  echo "  Rebase has been aborted."
  echo
  echo "  Run:"
  echo
  echo "    timew resolve"
  echo

  git rebase --abort
  exit 1
fi

if [ "$HAS_LOCAL_CHANGES" = true ]; then
  echo "→ Pushing local changes..."
  git push origin main
else
  echo "→ No local changes to push."
fi

echo
echo "✓ Timewarrior synchronized successfully."
